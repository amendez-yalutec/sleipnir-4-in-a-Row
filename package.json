{
  "name": "cuatro-en-linea-8x7",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de Cuatro en línea 8×7 y app web para jugar contra él — Equipo 6",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.ts automatico",
    "test:e2e:demo": "node scripts/e2e.ts demora",
    "mock": "node tools/mock-arbiter/src/cli.ts",
    "bot": "node --env-file-if-exists=.env apps/bot/src/main.ts",
    "bench": "node scripts/bench-search.ts",
    "dev": "node scripts/dev.ts",
    "web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run audit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
