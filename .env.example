# Copiar a .env (git lo ignora). Ver PLAN_BACKEND.md §8.
# TEAM_TOKEN y ARBITRO_ENABLED=true van SOLO en la máquina A (la que juega el torneo).

ARBITRO_URL=
TEAM_TOKEN=
ARBITRO_ENABLED=false
# Id público del equipo en el árbitro (p. ej. eq6): la app muestra solo nuestras partidas.
TEAM_ID=

# API de la app: 127.0.0.1 por defecto; 0.0.0.0 solo en la máquina de demo.
PORT=8080
HOST=127.0.0.1

# Presupuesto de búsqueda (ms) y espera del long polling (s).
THINK_SOFT_MS=1800
THINK_HARD_MS=2200
LONGPOLL_WAIT_S=20

LOG_DIR=./logs
# Build del frontend que sirve el mismo servidor (si existe).
WEB_DIR=apps/web/dist
